<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import java.net.URL?>
<SplitPane dividerPositions="0.5" prefHeight="600.0" prefWidth="1000.0" styleClass="glass-panel"
           BorderPane.alignment="CENTER" xmlns="http://javafx.com/javafx/26.0.2" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="org.slk200.pdfreaderv26.controller.TicketController">
    <stylesheets>
        <URL value="@../css/custom.css"/>
    </stylesheets>
    <AnchorPane maxWidth="210.0" minWidth="210.0">
        <ListView fx:id="ticketIdList" AnchorPane.bottomAnchor="50.0" AnchorPane.leftAnchor="0.0"
                  AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="10.0"/>
        <Button fx:id="lastButton" layoutX="28.0" layoutY="559.0" mnemonicParsing="false" onAction="#lastPage"
                text="上页" AnchorPane.bottomAnchor="10.0" AnchorPane.leftAnchor="50.0"/>
        <Button fx:id="nextButton" layoutX="114.0" layoutY="562.0" mnemonicParsing="false" onAction="#nextPage"
                text="下页" AnchorPane.bottomAnchor="10.0" AnchorPane.rightAnchor="50.0"/>
    </AnchorPane>
    <AnchorPane>
        <Label fx:id="ticketIdLabel" style="-fx-font-weight: bold" text="工单编号" AnchorPane.leftAnchor="0.0"
               AnchorPane.topAnchor="0.0"/>
        <Label fx:id="updateTimeLabel" layoutX="11.0" layoutY="30.0" text="工单时间" AnchorPane.leftAnchor="0.0"/>
        <Button fx:id="updateButton" alignment="BASELINE_RIGHT" mnemonicParsing="false" onAction="#updateTicketState"
                text="已完成" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0"/>
        <TableView fx:id="ticketContentTable" layoutX="20.0" layoutY="60.0" maxWidth="1.7976931348623157E308"
                   AnchorPane.bottomAnchor="185.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0"
                   AnchorPane.topAnchor="50.0">
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
            <columns>
                <TableColumn fx:id="fileNameColumn" editable="false" minWidth="75.0" sortable="false" text="文件名"/>
                <TableColumn fx:id="pageColumn" editable="false" minWidth="20.0" sortable="false" text="页数"/>
                <TableColumn fx:id="noteColumn" editable="false" minWidth="300.0" sortable="false" text="备注"/>
            </columns>
        </TableView>
        <Label fx:id="fileLabel" alignment="CENTER" contentDisplay="CENTER" layoutX="10.0" layoutY="446.0"
               maxWidth="1.7976931348623157E308" text="文件" textAlignment="CENTER" textOverrun="CENTER_ELLIPSIS"
               AnchorPane.bottomAnchor="150.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">
            <font>
                <Font name="System Bold" size="18.0"/>
            </font>
        </Label>
        <GridPane hgap="10" layoutX="20.0" layoutY="398.0" maxWidth="1.7976931348623157E308" vgap="10"
                  AnchorPane.bottomAnchor="60.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">
            <columnConstraints>
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0"/>
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0"/>
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0"/>
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0"/>
            </columnConstraints>
            <rowConstraints>
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES"/>
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES"/>
            </rowConstraints>

            <Label fx:id="paperTypeLabel" alignment="CENTER" contentDisplay="CENTER" maxHeight="1.7976931348623157E308"
                   maxWidth="1.7976931348623157E308" styleClass="mark" text="纸张类型" textAlignment="CENTER"
                   textOverrun="CENTER_ELLIPSIS">
                <font>
                    <Font name="System Bold"/>
                </font>
            </Label>
            <Label fx:id="pageSizeLabel" alignment="CENTER" contentDisplay="CENTER" maxHeight="1.7976931348623157E308"
                   maxWidth="1.7976931348623157E308" styleClass="mark" text="纸张大小" textAlignment="CENTER"
                   textOverrun="CENTER_ELLIPSIS" GridPane.columnIndex="1">
                <font>
                    <Font name="System Bold"/>
                </font>
            </Label>
            <Label fx:id="singleOrDoubleLabel" alignment="CENTER" contentDisplay="CENTER"
                   maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" styleClass="mark" text="单双面"
                   textAlignment="CENTER" textOverrun="CENTER_ELLIPSIS" GridPane.columnIndex="2">
                <font>
                    <Font name="System Bold"/>
                </font>
            </Label>
            <Label fx:id="colorLabel" alignment="CENTER" contentDisplay="CENTER" maxHeight="1.7976931348623157E308"
                   maxWidth="1.7976931348623157E308" styleClass="mark" text="颜色" textAlignment="CENTER"
                   textOverrun="CENTER_ELLIPSIS" GridPane.columnIndex="3">
                <font>
                    <Font name="System Bold"/>
                </font>
            </Label>
            <Label fx:id="pageRangeLabel" alignment="CENTER" contentDisplay="CENTER" maxHeight="1.7976931348623157E308"
                   maxWidth="1.7976931348623157E308" styleClass="mark" text="页数范围" textAlignment="CENTER"
                   textOverrun="CENTER_ELLIPSIS" GridPane.columnIndex="0" GridPane.rowIndex="1">
                <font>
                    <Font name="System Bold"/>
                </font>
            </Label>
            <Label fx:id="printCopiesLabel" alignment="CENTER" contentDisplay="CENTER"
                   maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" styleClass="mark"
                   text="打印份数" textAlignment="CENTER" textOverrun="CENTER_ELLIPSIS" GridPane.columnIndex="1"
                   GridPane.rowIndex="1">
                <font>
                    <Font name="System Bold"/>
                </font>
            </Label>
            <Label fx:id="packagingLabel" alignment="CENTER" contentDisplay="CENTER" maxHeight="1.7976931348623157E308"
                   maxWidth="1.7976931348623157E308" styleClass="mark" text="封装工艺" textAlignment="CENTER"
                   textOverrun="CENTER_ELLIPSIS" GridPane.columnIndex="2" GridPane.rowIndex="1">
                <font>
                    <Font name="System Bold"/>
                </font>
            </Label>
            <Label fx:id="postPressLabel" alignment="CENTER" contentDisplay="CENTER" maxHeight="1.7976931348623157E308"
                   maxWidth="1.7976931348623157E308" styleClass="mark" text="印后工艺" textAlignment="CENTER"
                   textOverrun="CENTER_ELLIPSIS" GridPane.columnIndex="3" GridPane.rowIndex="1">
                <font>
                    <Font name="System Bold"/>
                </font>
            </Label>
        </GridPane>
        <Label fx:id="noteLabel" alignment="CENTER" contentDisplay="CENTER" maxHeight="1.7976931348623157E308"
               maxWidth="1.7976931348623157E308" prefHeight="50.0" styleClass="mark" text="备注"
               textOverrun="CENTER_ELLIPSIS" wrapText="true" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0"
               AnchorPane.rightAnchor="0.0">
            <font>
                <Font name="System Bold"/>
            </font>
            <padding>
                <Insets bottom="5.0" left="5.0" right="5.0" top="5.0"/>
            </padding>
        </Label>
        <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
        </padding>
    </AnchorPane>
</SplitPane>
