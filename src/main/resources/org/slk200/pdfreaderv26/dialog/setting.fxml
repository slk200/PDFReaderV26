<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import java.net.URL?>
<BorderPane xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/26.0.2"
            styleClass="glass-panel" fx:controller="org.slk200.pdfreaderv26.controller.SettingController"
            prefHeight="600">
    <left>
        <VBox spacing="8.0">
            <padding>
                <Insets bottom="18.0" left="18.0" right="18.0" top="18.0"/>
            </padding>

            <Label text="设置默认位置"/>
            <HBox alignment="CENTER_LEFT" spacing="6.0">
                <TextField fx:id="defaultPlace" disable="true" promptText="文件的接收位置" HBox.hgrow="ALWAYS"/>
                <Button mnemonicParsing="false" onAction="#handleChooseDirectory" text="浏览"/>
            </HBox>

            <Label fx:id="errorTip" style="-fx-text-fill: red"/>

            <Label text="附加项"/>
            <TableView fx:id="extraTable" editable="true" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="nameColumn" editable="false" sortable="false" text="选项"/>
                    <TableColumn fx:id="priceColumn" editable="false" sortable="false" text="单价"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
                <contextMenu>
                    <ContextMenu>
                        <items>
                            <MenuItem mnemonicParsing="false" onAction="#handleDeleteExtra" text="删除"/>
                        </items>
                    </ContextMenu>
                </contextMenu>
            </TableView>

            <HBox alignment="CENTER_LEFT" spacing="6.0">
                <TextField fx:id="nameField" promptText="名称" HBox.hgrow="ALWAYS"/>
                <Spinner fx:id="priceSpinner" editable="true"/>
                <Button mnemonicParsing="false" onAction="#handleAddExtra" text="添加"/>
            </HBox>

            <stylesheets>
                <URL value="@../css/custom.css"/>
            </stylesheets>
        </VBox>
    </left>
    <center>
        <GridPane hgap="20.0" vgap="20.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="18.0" left="18.0" right="18.0" top="18.0"/>
            </padding>
            <columnConstraints>
                <ColumnConstraints hgrow="SOMETIMES" minWidth="50.0"/>
                <ColumnConstraints hgrow="SOMETIMES" minWidth="50.0"/>
            </columnConstraints>
            <rowConstraints>
                <RowConstraints minHeight="50.0" vgrow="SOMETIMES"/>
                <RowConstraints minHeight="50.0" vgrow="SOMETIMES"/>
            </rowConstraints>

            <VBox spacing="6.0" GridPane.columnIndex="0" GridPane.rowIndex="0">
                <Label text="纸张类型"/>
                <TableView fx:id="paperTypeTable" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="paperTypeColumn" editable="false" sortable="false" text="选项名称"/>
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>
                    <contextMenu>
                        <ContextMenu>
                            <items>
                                <MenuItem mnemonicParsing="false" onAction="#handleDeletePaperType" text="删除"/>
                            </items>
                        </ContextMenu>
                    </contextMenu>
                </TableView>
                <HBox alignment="CENTER_LEFT" spacing="6.0">
                    <TextField fx:id="paperTypeField" promptText="如：80g双胶纸" HBox.hgrow="ALWAYS"/>
                    <Button mnemonicParsing="false" onAction="#handleAddPaperType" text="添加"/>
                </HBox>
            </VBox>

            <VBox spacing="6.0" GridPane.columnIndex="1" GridPane.rowIndex="0">
                <Label text="纸张大小"/>
                <TableView fx:id="paperSizeTable" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="paperSizeColumn" editable="false" sortable="false" text="选项名称"/>
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>
                    <contextMenu>
                        <ContextMenu>
                            <items>
                                <MenuItem mnemonicParsing="false" onAction="#handleDeletePaperSize" text="删除"/>
                            </items>
                        </ContextMenu>
                    </contextMenu>
                </TableView>
                <HBox alignment="CENTER_LEFT" spacing="6.0">
                    <TextField fx:id="paperSizeField" promptText="如：A4、B5" HBox.hgrow="ALWAYS"/>
                    <Button mnemonicParsing="false" onAction="#handleAddPaperSize" text="添加"/>
                </HBox>
            </VBox>

            <VBox spacing="6.0" GridPane.columnIndex="0" GridPane.rowIndex="1">
                <Label text="封装工艺"/>
                <TableView fx:id="bindingTable" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="bindingColumn" editable="false" sortable="false" text="选项名称"/>
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>
                    <contextMenu>
                        <ContextMenu>
                            <items>
                                <MenuItem mnemonicParsing="false" onAction="#handleDeleteBinding" text="删除"/>
                            </items>
                        </ContextMenu>
                    </contextMenu>
                </TableView>
                <HBox alignment="CENTER_LEFT" spacing="6.0">
                    <TextField fx:id="bindingField" promptText="如：骑马钉、胶装" HBox.hgrow="ALWAYS"/>
                    <Button mnemonicParsing="false" onAction="#handleAddBinding" text="添加"/>
                </HBox>
            </VBox>

            <VBox spacing="6.0" GridPane.columnIndex="1" GridPane.rowIndex="1">
                <Label text="印后工艺"/>
                <TableView fx:id="postPressTable" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="postPressColumn" editable="false" sortable="false" text="选项名称"/>
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>
                    <contextMenu>
                        <ContextMenu>
                            <items>
                                <MenuItem mnemonicParsing="false" onAction="#handleDeletePostPress" text="删除"/>
                            </items>
                        </ContextMenu>
                    </contextMenu>
                </TableView>
                <HBox alignment="CENTER_LEFT" spacing="6.0">
                    <TextField fx:id="postPressField" promptText="如：覆哑膜、局部UV" HBox.hgrow="ALWAYS"/>
                    <Button mnemonicParsing="false" onAction="#handleAddPostPress" text="添加"/>
                </HBox>
            </VBox>
        </GridPane>
    </center>
    <top>
        <Label text="所有设置项目都要点 ——确定—— 后才会保存生效" style="-fx-text-fill: #1f85fe; -fx-font-size:16; -fx-font-weight: bold;" BorderPane.alignment="CENTER"/>
    </top>
</BorderPane>
