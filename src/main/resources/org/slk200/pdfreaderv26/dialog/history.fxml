<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import java.net.URL?>
<VBox alignment="CENTER_LEFT" prefHeight="600.0" prefWidth="1000" spacing="12.0"
      xmlns="http://javafx.com/javafx/26.0.2" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.slk200.pdfreaderv26.controller.HistoryController">
    <stylesheets>
        <URL value="@../css/custom.css"/>
    </stylesheets>
    <padding>
        <Insets left="16.0" right="16.0"/>
    </padding>
    <HBox alignment="CENTER_LEFT" spacing="8.0">
        <Label text="搜索"/>
        <TextField fx:id="keywordField" prefWidth="572.0" promptText="输入文件名或路径关键词"/>
    </HBox>
    <HBox alignment="CENTER_LEFT" spacing="10.0">
        <Label text="起始日期"/>
        <DatePicker fx:id="fromPicker" prefWidth="140.0" promptText="年/月/日"/>
        <Label text="截止日期"/>
        <DatePicker fx:id="toPicker" prefWidth="140.0" promptText="年/月/日"/>
        <Label text="状态"/>
        <ComboBox fx:id="statusBox" prefWidth="90.0"/>
        <Button fx:id="resetButton" mnemonicParsing="false" text="重置"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="recordsLabel" alignment="CENTER_RIGHT" contentDisplay="RIGHT" textOverrun="CENTER_ELLIPSIS"/>
    </HBox>
    <TableView fx:id="convertRecordTableView" VBox.vgrow="ALWAYS">
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
        <columns>
            <TableColumn fx:id="timeColumn" editable="false" minWidth="150.0" sortable="false" text="时间"/>
            <TableColumn fx:id="nameColumn" editable="false" minWidth="200.0" sortable="false" text="文件名"/>
            <TableColumn fx:id="pathColumn" editable="false" minWidth="300.0" sortable="false" text="路径"/>
            <TableColumn fx:id="statusColumn" editable="false" minWidth="60.0" sortable="false" text="状态"/>
        </columns>
    </TableView>
    <HBox alignment="CENTER" spacing="10.0">
        <Button fx:id="lastButton" mnemonicParsing="false" onAction="#lastPage" text="上页"/>
        <Button fx:id="nextButton" mnemonicParsing="false" onAction="#nextPage" text="下页"/>
    </HBox>
</VBox>
