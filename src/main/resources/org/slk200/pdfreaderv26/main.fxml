<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.input.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<?import org.slk200.pdfreaderv26.component.BusyOverlay?>
<?import org.slk200.pdfreaderv26.component.FloatingConvertButton?>
<?import java.net.URL?>
<StackPane prefHeight="800" prefWidth="1300" xmlns="http://javafx.com/javafx/26.0.2"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="org.slk200.pdfreaderv26.controller.MainController">
    <BorderPane>
        <center>
            <BorderPane>
                <padding>
                    <Insets bottom="12.0" left="12.0" right="12.0" top="8.0"/>
                </padding>
                <left>
                    <VBox spacing="10.0" styleClass="glass-panel" BorderPane.alignment="TOP_LEFT">
                        <BorderPane.margin>
                            <Insets right="12.0"/>
                        </BorderPane.margin>
                        <padding>
                            <Insets bottom="12.0" left="12.0" right="12.0" top="12.0"/>
                        </padding>
                        <GridPane>
                            <columnConstraints>
                                <ColumnConstraints hgrow="SOMETIMES" minWidth="21.25"/>
                                <ColumnConstraints hgrow="SOMETIMES" minWidth="5.0"/>
                                <ColumnConstraints hgrow="SOMETIMES" minWidth="21.25"/>
                                <ColumnConstraints hgrow="SOMETIMES" minWidth="5.0"/>
                                <ColumnConstraints hgrow="SOMETIMES" minWidth="21.25"/>
                                <ColumnConstraints hgrow="SOMETIMES" minWidth="5.0"/>
                                <ColumnConstraints hgrow="SOMETIMES" minWidth="21.25"/>
                            </columnConstraints>
                            <rowConstraints>
                                <RowConstraints vgrow="SOMETIMES"/>
                                <RowConstraints vgrow="SOMETIMES"/>
                            </rowConstraints>
                            <Label text="页数">
                                <padding>
                                    <Insets bottom="2.0" left="2.0"/>
                                </padding>
                            </Label>
                            <Label text="单价" GridPane.columnIndex="2">
                                <padding>
                                    <Insets bottom="2.0" left="2.0"/>
                                </padding>
                            </Label>
                            <Label text="份数" GridPane.columnIndex="4">
                                <padding>
                                    <Insets bottom="2.0" left="2.0"/>
                                </padding>
                            </Label>
                            <Label text="特殊" GridPane.columnIndex="6">
                                <padding>
                                    <Insets bottom="2.0" left="2.0"/>
                                </padding>
                            </Label>
                            <Spinner fx:id="pageSpinner" editable="true" prefHeight="26.0" prefWidth="82.0"
                                     GridPane.rowIndex="1"/>
                            <Label text="x" GridPane.columnIndex="1" GridPane.rowIndex="1">
                                <padding>
                                    <Insets left="5.0" right="5.0"/>
                                </padding>
                            </Label>
                            <Spinner fx:id="priceSpinner" editable="true" prefHeight="26.0" prefWidth="82.0"
                                     GridPane.columnIndex="2" GridPane.rowIndex="1"/>
                            <Label text="x" GridPane.columnIndex="3" GridPane.rowIndex="1">
                                <padding>
                                    <Insets left="5.0" right="5.0"/>
                                </padding>
                            </Label>
                            <Spinner fx:id="numSpinner" editable="true" prefHeight="26.0" prefWidth="82.0"
                                     GridPane.columnIndex="4" GridPane.rowIndex="1"/>
                            <Label text="+" GridPane.columnIndex="5" GridPane.rowIndex="1">
                                <padding>
                                    <Insets left="5.0" right="5.0"/>
                                </padding>
                            </Label>
                            <Spinner fx:id="specSpinner" editable="true" prefHeight="26.0" prefWidth="82.0"
                                     GridPane.columnIndex="6" GridPane.rowIndex="1"/>
                        </GridPane>
                        <Button maxWidth="1.7976931348623157E308" onAction="#sum" styleClass="sum"
                                style="-fx-text-fill: #dbe3f6; -fx-font-weight: bold;" text="累计"/>
                        <ListView fx:id="sumList" maxWidth="1.7976931348623157E308" prefHeight="200.0"
                                  VBox.vgrow="ALWAYS">
                            <contextMenu>
                                <ContextMenu>
                                    <items>
                                        <MenuItem mnemonicParsing="false" onAction="#deleteSum" text="删除"/>
                                    </items>
                                </ContextMenu>
                            </contextMenu>
                        </ListView>
                        <HBox alignment="CENTER_LEFT" spacing="6.0">
                            <ComboBox fx:id="extraComboBox" maxWidth="1.7976931348623157E308" HBox.hgrow="ALWAYS"/>
                            <Button mnemonicParsing="false" onAction="#addExtra" text="添加"/>
                        </HBox>
                        <TableView fx:id="extraTable" editable="true" maxWidth="1.7976931348623157E308"
                                   VBox.vgrow="ALWAYS">
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                            </columnResizePolicy>
                            <columns>
                                <TableColumn fx:id="extraColumn" editable="false" minWidth="50.0" sortable="false"
                                             text="附加项"/>
                                <TableColumn fx:id="priceColumn" editable="false" minWidth="20.0" sortable="false"
                                             text="单价"/>
                                <TableColumn fx:id="copiesColumn" editable="false" minWidth="30.0" sortable="false"
                                             text="份数"/>
                            </columns>
                            <contextMenu>
                                <ContextMenu>
                                    <items>
                                        <MenuItem mnemonicParsing="false" onAction="#deleteExtra" text="删除"/>
                                    </items>
                                </ContextMenu>
                            </contextMenu>
                        </TableView>
                    </VBox>
                </left>
                <center>
                    <StackPane styleClass="glass-panel" BorderPane.alignment="CENTER">
                        <VBox spacing="8.0">
                            <padding>
                                <Insets bottom="12.0" left="12.0" right="12.0" top="12.0"/>
                            </padding>
                            <GridPane hgap="10.0">
                                <columnConstraints>
                                    <ColumnConstraints hgrow="SOMETIMES" prefWidth="16.7"/>
                                    <ColumnConstraints hgrow="SOMETIMES" prefWidth="16.7"/>
                                    <ColumnConstraints hgrow="SOMETIMES" prefWidth="16.7"/>
                                    <ColumnConstraints hgrow="SOMETIMES" prefWidth="16.7"/>
                                    <ColumnConstraints hgrow="SOMETIMES" prefWidth="16.7"/>
                                    <ColumnConstraints hgrow="SOMETIMES" prefWidth="16.7"/>
                                </columnConstraints>
                                <rowConstraints>
                                    <RowConstraints minHeight="10.0" vgrow="SOMETIMES"/>
                                </rowConstraints>
                                <opaqueInsets>
                                    <Insets/>
                                </opaqueInsets>
                                <HBox alignment="CENTER_LEFT" spacing="6.0" styleClass="card">
                                    <ImageView fitHeight="36.0" fitWidth="36.0" pickOnBounds="true"
                                               preserveRatio="true">
                                        <Image url="@image/office_doc@64px.png"/>
                                    </ImageView>
                                    <Label fx:id="wordLabel" text="Word 0"/>
                                    <padding>
                                        <Insets bottom="5.0" left="10.0" top="5.0"/>
                                    </padding>
                                </HBox>
                                <HBox alignment="CENTER_LEFT" spacing="6.0" styleClass="card" GridPane.columnIndex="1">
                                    <ImageView fitHeight="36.0" fitWidth="36.0" pickOnBounds="true"
                                               preserveRatio="true">
                                        <Image url="@image/office_els@64px.png"/>
                                    </ImageView>
                                    <Label fx:id="excelLabel" text="Excel 0"/>
                                    <padding>
                                        <Insets bottom="5.0" left="10.0" top="5.0"/>
                                    </padding>
                                </HBox>
                                <HBox alignment="CENTER_LEFT" spacing="6.0" styleClass="card" GridPane.columnIndex="2">
                                    <ImageView fitHeight="36.0" fitWidth="36.0" pickOnBounds="true"
                                               preserveRatio="true">
                                        <Image url="@image/office_ppt@64px.png"/>
                                    </ImageView>
                                    <Label fx:id="pptLabel" text="PPT 0"/>
                                    <padding>
                                        <Insets bottom="5.0" left="10.0" top="5.0"/>
                                    </padding>
                                </HBox>
                                <HBox alignment="CENTER_LEFT" spacing="6.0" styleClass="card" GridPane.columnIndex="3">
                                    <ImageView fitHeight="36.0" fitWidth="36.0" pickOnBounds="true"
                                               preserveRatio="true">
                                        <Image url="@image/office_pdf@64px.png"/>
                                    </ImageView>
                                    <Label fx:id="pdfLabel" text="PDF 0"/>
                                    <padding>
                                        <Insets bottom="5.0" left="10.0" top="5.0"/>
                                    </padding>
                                </HBox>
                                <HBox alignment="CENTER_LEFT" spacing="6.0" styleClass="card" GridPane.columnIndex="4">
                                    <ImageView fitHeight="36.0" fitWidth="36.0" pickOnBounds="true"
                                               preserveRatio="true">
                                        <Image url="@image/office_image@64px.png"/>
                                    </ImageView>
                                    <Label fx:id="imageLabel" text="图像 0"/>
                                    <padding>
                                        <Insets bottom="5.0" left="10.0" top="5.0"/>
                                    </padding>
                                </HBox>
                                <HBox alignment="CENTER_LEFT" spacing="6.0" styleClass="card" GridPane.columnIndex="5">
                                    <ImageView fitHeight="36.0" fitWidth="36.0" pickOnBounds="true"
                                               preserveRatio="true">
                                        <Image url="@image/office_other@64px.png"/>
                                    </ImageView>
                                    <Label fx:id="otherLabel" text="其他 0"/>
                                    <padding>
                                        <Insets bottom="5.0" left="10.0" top="5.0"/>
                                    </padding>
                                </HBox>
                            </GridPane>
                            <TableView fx:id="fileItemTableView" maxWidth="1.7976931348623157E308" VBox.vgrow="ALWAYS">
                                <columnResizePolicy>
                                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                                </columnResizePolicy>
                                <columns>
                                    <TableColumn fx:id="typeColumn" editable="false" minWidth="50.0" sortable="false"
                                                 text="类型"/>
                                    <TableColumn fx:id="nameColumn" editable="false" minWidth="200.0" sortable="false"
                                                 text="文件名"/>
                                    <TableColumn fx:id="stateColumn" editable="false" minWidth="120.0" sortable="false"
                                                 text="状态"/>
                                    <TableColumn fx:id="pageColumn" editable="false" minWidth="50.0" sortable="false"
                                                 text="页数"/>
                                    <TableColumn fx:id="pathColumn" editable="false" minWidth="200.0" sortable="false"
                                                 text="文件路径"/>
                                    <TableColumn fx:id="noteColumn" editable="false" minWidth="200.0" sortable="false"
                                                 text="备注"/>
                                </columns>
                                <contextMenu>
                                    <ContextMenu onShowing="#onPendedMenuShowing">
                                        <items>
                                            <MenuItem fx:id="openFileItem" mnemonicParsing="false" onAction="#openFile"
                                                      text="打开文件"/>
                                            <MenuItem fx:id="openPDFFileItem" mnemonicParsing="false"
                                                      onAction="#openPDFFile"
                                                      text="打开PDF文件"/>
                                            <MenuItem fx:id="openFolderItem" mnemonicParsing="false"
                                                      onAction="#showInExplore"
                                                      text="打开文件夹"/>
                                            <SeparatorMenuItem mnemonicParsing="false"/>
                                            <MenuItem fx:id="markMenuItem" mnemonicParsing="false" onAction="#mark"
                                                      text="标记"/>
                                            <MenuItem fx:id="editMarkMenuItem" mnemonicParsing="false"
                                                      onAction="#editMark"
                                                      text="修改标记"/>
                                            <MenuItem fx:id="copyMarkMenuItem" mnemonicParsing="false"
                                                      onAction="#copyMark"
                                                      text="复制标记"/>
                                            <MenuItem fx:id="pasteMarkMenuItem" mnemonicParsing="false"
                                                      onAction="#pasteMark" text="粘贴标记"/>
                                        </items>
                                    </ContextMenu>
                                </contextMenu>
                            </TableView>
                        </VBox>
                        <BusyOverlay fx:id="busyOverlay"
                                     style="-fx-background-color: transparent; -fx-background-radius: 18; -fx-border-color: transparent"/>
                    </StackPane>
                </center>
                <top>
                    <BorderPane styleClass="glass-panel" BorderPane.alignment="CENTER">
                        <BorderPane.margin>
                            <Insets bottom="12.0"/>
                        </BorderPane.margin>
                        <padding>
                            <Insets bottom="10.0" left="12.0" right="12.0" top="10.0"/>
                        </padding>
                        <right>
                            <HBox spacing="25.0" BorderPane.alignment="CENTER">
                                <Label fx:id="totalPage" alignment="CENTER" prefHeight="35.0"
                                       style="-fx-background-color: #dde4fd;-fx-background-radius: 10; -fx-text-fill: #202c63"
                                       text="总页数：0">
                                    <font>
                                        <Font name="System Bold" size="16.0"/>
                                    </font>
                                    <padding>
                                        <Insets left="25.0" right="25.0"/>
                                    </padding>
                                </Label>
                                <Label fx:id="totalAmountLabel" alignment="CENTER" prefHeight="35.0"
                                       style="-fx-background-color: #fbe8d3; -fx-background-radius: 10; -fx-text-fill: #dd6825"
                                       text="总价：0.00元">
                                    <padding>
                                        <Insets left="25.0" right="25.0"/>
                                    </padding>
                                    <font>
                                        <Font name="System Bold" size="16.0"/>
                                    </font>
                                </Label>
                            </HBox>
                        </right>
                        <left>
                            <HBox alignment="CENTER_LEFT" spacing="10" BorderPane.alignment="CENTER">
                                <ImageView fitHeight="32.0" fitWidth="32.0" pickOnBounds="true" preserveRatio="true">
                                    <Image url="@image/folder@64px.png"/>
                                </ImageView>
                                <TextField fx:id="directoryField" disable="true" promptText="选择文件夹"
                                           HBox.hgrow="ALWAYS"/>
                                <Button mnemonicParsing="false" onAction="#scanDirectory" prefWidth="55.0" text="浏览"/>
                                <Button fx:id="executeButton" mnemonicParsing="false" onAction="#execute"
                                        prefWidth="55.0" text="执行"/>
                            </HBox>
                        </left>
                        <center>
                            <HBox alignment="CENTER_LEFT" spacing="20.0" BorderPane.alignment="CENTER">
                                <padding>
                                    <Insets left="72.0"/>
                                </padding>
                                <Button fx:id="submitTicketButton" mnemonicParsing="false" onAction="#ticketSubmit"
                                        style="-fx-text-fill: #1f85fe;-fx-font-size: 16"
                                        text="提交工单"/>
                                <Button mnemonicParsing="false" onAction="#openTicketCenter"
                                        style="-fx-text-fill: #d36323;-fx-font-size: 16"
                                        text="工单中心"/>
                            </HBox>
                        </center>
                    </BorderPane>
                </top>
            </BorderPane>
        </center>
        <top>
            <MenuBar BorderPane.alignment="CENTER">
                <BorderPane.margin>
                    <Insets/>
                </BorderPane.margin>
                <padding>
                    <Insets bottom="2" left="6" right="6" top="2"/>
                </padding>
                <Menu mnemonicParsing="false" text="文件">
                    <MenuItem mnemonicParsing="false" onAction="#scanDirectory" text="打开文件夹">
                        <accelerator>
                            <KeyCodeCombination alt="UP" code="O" control="DOWN" meta="UP" shift="UP" shortcut="UP"/>
                        </accelerator>
                    </MenuItem>
                    <SeparatorMenuItem mnemonicParsing="false"/>
                    <MenuItem mnemonicParsing="false" onAction="#exit" text="退出">
                        <accelerator>
                            <KeyCodeCombination alt="UP" code="Q" control="DOWN" meta="UP" shift="UP" shortcut="UP"/>
                        </accelerator>
                    </MenuItem>
                </Menu>
                <Menu mnemonicParsing="false" text="编辑">
                    <MenuItem mnemonicParsing="false" onAction="#setting" text="设置">
                        <accelerator>
                            <KeyCodeCombination alt="DOWN" code="S" control="DOWN" meta="UP" shift="UP" shortcut="UP"/>
                        </accelerator>
                    </MenuItem>
                    <Menu fx:id="themeMenu" mnemonicParsing="false" text="主题">
                        <accelerator>
                            <KeyCodeCombination alt="DOWN" code="T" control="DOWN" meta="UP" shift="UP" shortcut="UP"/>
                        </accelerator>
                        <RadioMenuItem fx:id="lightThemeItem" mnemonicParsing="false" onAction="#themeLight"
                                       text="浅色模式"/>
                        <RadioMenuItem fx:id="darkThemeItem" mnemonicParsing="false" onAction="#themeDark"
                                       text="深色模式"/>
                        <RadioMenuItem fx:id="systemThemeItem" mnemonicParsing="false" onAction="#themeSystem"
                                       text="跟随系统主题"/>
                    </Menu>
                    <SeparatorMenuItem mnemonicParsing="false"/>
                    <MenuItem fx:id="executeMenu" mnemonicParsing="false" onAction="#execute" text="执行">
                        <accelerator>
                            <KeyCodeCombination alt="UP" code="E" control="DOWN" meta="UP" shift="UP" shortcut="UP"/>
                        </accelerator>
                    </MenuItem>
                    <MenuItem mnemonicParsing="false" onAction="#reset" text="恢复">
                        <accelerator>
                            <KeyCodeCombination alt="UP" code="R" control="DOWN" meta="UP" shift="UP" shortcut="UP"/>
                        </accelerator>
                    </MenuItem>
                </Menu>
                <Menu mnemonicParsing="false" text="帮助">
                    <MenuItem mnemonicParsing="false" onAction="#history" text="历史">
                        <accelerator>
                            <KeyCodeCombination alt="UP" code="H" control="DOWN" meta="UP" shift="UP" shortcut="UP"/>
                        </accelerator>
                    </MenuItem>
                    <MenuItem mnemonicParsing="false" onAction="#about" text="关于">
                        <accelerator>
                            <KeyCodeCombination alt="UP" code="F12" control="DOWN" meta="UP" shift="UP" shortcut="UP"/>
                        </accelerator>
                    </MenuItem>
                </Menu>
            </MenuBar>
        </top>
    </BorderPane>
    <FloatingConvertButton fx:id="floatingConvertButton"/>
    <stylesheets>
        <URL value="@css/custom.css"/>
    </stylesheets>
</StackPane>
